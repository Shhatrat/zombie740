#!/bin/sh
. /www/cgi-bin/common.sh

html_head "Status" "status"

UPTIME=$(awk '{s=$1/86400; h=($1%86400)/3600; m=($1%3600)/60; printf "%dd %dh %dm", s, h, m}' /proc/uptime)
MEMTOTAL=$(awk '/MemTotal/{print $2}' /proc/meminfo)
MEMFREE=$(awk '/MemAvailable/{print $2}' /proc/meminfo)
MEMUSED=$(( (MEMTOTAL - MEMFREE) / 1024 ))
MEMTOTAL_MB=$(( MEMTOTAL / 1024 ))
MEMPCT=$(( (MEMTOTAL - MEMFREE) * 100 / MEMTOTAL ))
LOAD=$(cut -d' ' -f1 /proc/loadavg)
LOAD100=$(awk 'NR==1{printf "%d", $1*100}' /proc/loadavg)
[ "$LOAD100" -gt 400 ] && LOAD100=400
LOADPCT=$(( LOAD100 / 4 ))
[ "$(nft list ruleset 2>/dev/null | grep -c table)" -gt 0 ] && FW_LABEL='<span class="badge bg">&#9679; ACTIVE</span>' || FW_LABEL='<span class="badge br">&#9679; OFF</span>'

LAN_IP=$(ip -4 addr show br-lan 2>/dev/null | awk '/inet /{print $2}' | head -1)
[ -z "$LAN_IP" ] && LAN_IP=$(ip -4 addr show eth0 2>/dev/null | awk '/inet /{print $2}' | head -1)
WAN_IP=$(ip -4 addr show eth1 2>/dev/null | awk '/inet /{print $2}' | head -1)
[ -z "$WAN_IP" ] && WAN_IP="—"
GW=$(ip route show default 2>/dev/null | awk '{print $3}' | head -1)
[ -z "$GW" ] && GW="—"
DNS=$(awk '/^nameserver/{printf "%s ", $2}' /etc/resolv.conf | sed 's/ $//')
[ -z "$DNS" ] && DNS="—"

HOSTNAME=$(cat /proc/sys/kernel/hostname)
KERNEL=$(uname -r)
OPENWRT_VER=$(cat /etc/openwrt_release 2>/dev/null | grep DISTRIB_RELEASE | cut -d= -f2 | tr -d '"')
ARCH=$(uname -m)
FLASH_FREE=$(df /overlay 2>/dev/null | awk 'NR==2{print int($4/1024) " KB"}')
[ -z "$FLASH_FREE" ] && FLASH_FREE="—"
FLASH_PCT=$(df /overlay 2>/dev/null | awk 'NR==2{pct=int(($3/$2)*100); print pct}' 2>/dev/null || echo 0)

cat << HTML
<div class="g4">
  <div class="card">
    <div class="lbl">Uptime</div>
    <div class="val ok">$UPTIME</div>
  </div>
  <div class="card">
    <div class="lbl">RAM</div>
    <div class="val">$MEMUSED / $MEMTOTAL_MB MB</div>
    <div style="background:var(--pico-muted-border-color);border-radius:4px;height:6px;margin-top:.4rem">
      <div style="width:${MEMPCT}%;height:6px;border-radius:4px;background:var(--pico-primary)"></div>
    </div>
  </div>
  <div class="card">
    <div class="lbl">Load avg</div>
    <div class="val ok">$LOAD</div>
  </div>
  <div class="card">
    <div class="lbl">Firewall</div>
    <div class="val">$FW_LABEL</div>
  </div>
</div>
HTML

# SVG gauges
cat << HTML
<div class="g2" style="margin-bottom:1.5rem">
  <div class="card">
    <div class="sec">RAM — ${MEMPCT}% (${MEMUSED}/${MEMTOTAL_MB} MB)</div>
    <svg viewBox="0 0 300 40" style="width:100%;height:40px">
      <rect x="0" y="8" width="300" height="24" rx="4" fill="var(--pico-muted-border-color)"/>
      <rect x="0" y="8" width="$(( MEMPCT * 3 ))" height="24" rx="4" fill="$([ "$MEMPCT" -gt 80 ] && echo '#f44336' || [ "$MEMPCT" -gt 60 ] && echo '#ff9800' || echo 'var(--pico-primary)')"/>
      <text x="150" y="24" text-anchor="middle" fill="white" font-size="11" font-family="monospace">${MEMPCT}%</text>
    </svg>
  </div>
  <div class="card">
    <div class="sec">Load avg — $LOAD (${LOADPCT}% 1-core)</div>
    <svg viewBox="0 0 300 40" style="width:100%;height:40px">
      <rect x="0" y="8" width="300" height="24" rx="4" fill="var(--pico-muted-border-color)"/>
      <rect x="0" y="8" width="$(( LOADPCT * 3 ))" height="24" rx="4" fill="$([ "$LOADPCT" -gt 80 ] && echo '#f44336' || [ "$LOADPCT" -gt 50 ] && echo '#ff9800' || echo 'var(--pico-primary)')"/>
      <text x="150" y="24" text-anchor="middle" fill="white" font-size="11" font-family="monospace">${LOADPCT}%</text>
    </svg>
  </div>
</div>
HTML

cat << HTML
<div class="g2">
  <div class="card">
    <div class="sec">Siec</div>
    <table>
      <tbody>
        <tr><th>LAN</th><td>${LAN_IP:-—}</td><td><span class="badge bg">UP</span></td></tr>
        <tr><th>WAN</th><td>$WAN_IP</td><td>$([ "$WAN_IP" != "—" ] && echo '<span class="badge bg">UP</span>' || echo '<span class="badge br">DOWN</span>')</td></tr>
        <tr><th>Gateway</th><td>$GW</td><td></td></tr>
        <tr><th>DNS</th><td>$DNS</td><td></td></tr>
      </tbody>
    </table>
  </div>
  <div class="card">
    <div class="sec">System</div>
    <table>
      <tbody>
        <tr><th>Hostname</th><td>$HOSTNAME</td></tr>
        <tr><th>Kernel</th><td>$KERNEL</td></tr>
        <tr><th>OpenWrt</th><td>${OPENWRT_VER:-—}</td></tr>
        <tr><th>Arch</th><td>$ARCH</td></tr>
        <tr><th>Flash wolne</th><td>$FLASH_FREE</td></tr>
      </tbody>
    </table>
  </div>
</div>
HTML

LEASES=$(cat /tmp/dhcp.leases 2>/dev/null)
LEASE_COUNT=$(echo "$LEASES" | grep -c . 2>/dev/null || echo 0)
[ -z "$LEASES" ] && LEASE_COUNT=0

echo '<div class="card" style="margin-bottom:1.5rem">'
echo "<div class=\"sec\">Klienci DHCP ($LEASE_COUNT)</div>"
if [ "$LEASE_COUNT" -gt 0 ]; then
    echo '<table><thead><tr><th>IP</th><th>MAC</th><th>Hostname</th><th>Wygasa</th></tr></thead><tbody>'
    echo "$LEASES" | while read -r expire mac ip host rest; do
        NOW=$(date +%s)
        LEFT=$(( expire - NOW ))
        if [ "$LEFT" -gt 0 ]; then
            H=$(( LEFT / 3600 )); M=$(( (LEFT % 3600) / 60 ))
            TIME="${H}h ${M}m"
        else
            TIME="wygaslo"
        fi
        printf '<tr><td>%s</td><td>%s</td><td>%s</td><td>%s</td></tr>\n' \
            "$ip" "$mac" "${host:-?}" "$TIME"
    done
    echo '</tbody></table>'
else
    echo '<p style="color:var(--pico-muted-color);margin:0">Brak aktywnych dzierzaw.</p>'
fi
echo '</div>'

echo '<div class="card">'
echo '<div class="sec">Logi systemowe</div>'
echo '<pre>'
logread 2>/dev/null | tail -20 | sed 's/</\&lt;/g; s/>/\&gt;/g'
echo '</pre></div>'

html_foot

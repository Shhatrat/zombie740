#!/bin/sh
. /www/cgi-bin/common.sh

OUTPUT=""
TOOL=""
TARGET_VAL=""

if [ "$REQUEST_METHOD" = "POST" ]; then
    POST=$(parse_post)
    TOOL=$(get_param "$POST" "tool")
    TARGET_VAL=$(sanitize "$(get_param "$POST" "target")")
    TARGET_VAL=$(echo "$TARGET_VAL" | tr -cd 'a-zA-Z0-9._:-')

    if [ -n "$TARGET_VAL" ] || [ "$TOOL" = "conntrack" ]; then
        case "$TOOL" in
            ping)
                OUTPUT=$(ping -c 4 -W 2 "$TARGET_VAL" 2>&1)
                ;;
            traceroute)
                OUTPUT=$(traceroute -n -w 2 -m 15 "$TARGET_VAL" 2>&1)
                ;;
            nslookup)
                OUTPUT=$(nslookup "$TARGET_VAL" 2>&1)
                ;;
            wol)
                MAC=$(echo "$TARGET_VAL" | tr -cd '0-9a-fA-F:')
                if echo "$MAC" | grep -qE '^([0-9a-fA-F]{2}:){5}[0-9a-fA-F]{2}$'; then
                    OUTPUT=$(etherwake "$MAC" 2>&1 && echo "Pakiet WoL wyslany do $MAC")
                else
                    OUTPUT="Nieprawidlowy format MAC (XX:XX:XX:XX:XX:XX)"
                fi
                ;;
            iperf3)
                HOST=$(echo "$TARGET_VAL" | tr -cd 'a-zA-Z0-9._:-')
                if [ -n "$HOST" ]; then
                    OUTPUT=$(iperf3 -c "$HOST" -t 5 2>&1)
                else
                    OUTPUT="Podaj adres IP serwera iperf3."
                fi
                ;;
            conntrack)
                OUTPUT=$(cat /proc/net/nf_conntrack 2>/dev/null | head -100 || echo "conntrack niedostepny")
                TOOL="conntrack"
                TARGET_VAL="(tabela polaczen)"
                ;;
            *)
                OUTPUT="Nieznane narzedzie."
                ;;
        esac
    fi
fi

html_head "Diagnostyka" "diag"

if [ -n "$OUTPUT" ]; then
    echo '<div class="card" id="wynik" style="margin-bottom:1.5rem">'
    echo "<div class=\"sec\">Wynik: $TOOL $TARGET_VAL</div>"
    echo '<pre>'
    echo "$OUTPUT" | sed 's/</\&lt;/g; s/>/\&gt;/g'
    echo '</pre></div>'
    echo '<script>document.getElementById("wynik").scrollIntoView({behavior:"smooth"});</script>'
fi

cat << 'HTML'

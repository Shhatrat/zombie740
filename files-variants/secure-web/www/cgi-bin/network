#!/bin/sh
. /www/cgi-bin/common.sh

MSG=""

if [ "$REQUEST_METHOD" = "POST" ]; then
    POST=$(parse_post)
    ACTION=$(get_param "$POST" "action")

    if [ "$ACTION" = "lan" ]; then
        LAN_IP=$(sanitize "$(get_param "$POST" "lan_ip")")
        LAN_MASK=$(sanitize "$(get_param "$POST" "lan_mask")")
        if echo "$LAN_IP" | grep -qE '^[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}$'; then
            uci set network.lan.ipaddr="$LAN_IP"
            uci set network.lan.netmask="$LAN_MASK"
            uci commit network
            /etc/init.d/network reload >/dev/null 2>&1
            MSG='<div class="flash-ok">Konfiguracja LAN zapisana. Router moze byc niedostepny przez chwile.</div>'
        else
            MSG='<div class="flash-err">Nieprawidlowy adres IP.</div>'
        fi
    fi

    if [ "$ACTION" = "wan" ]; then
        WAN_PROTO=$(get_param "$POST" "wan_proto")
        case "$WAN_PROTO" in dhcp|static|pppoe) ;; *) WAN_PROTO="dhcp" ;; esac
        uci set network.wan.proto="$WAN_PROTO"
        if [ "$WAN_PROTO" = "static" ]; then
            WAN_IP=$(sanitize "$(get_param "$POST" "wan_ip")")
            WAN_GW=$(sanitize "$(get_param "$POST" "wan_gw")")
            WAN_DNS=$(sanitize "$(get_param "$POST" "wan_dns")")
            uci set network.wan.ipaddr="$WAN_IP"
            uci set network.wan.gateway="$WAN_GW"
            uci set network.wan.dns="$WAN_DNS"
        fi
        uci commit network
        /etc/init.d/network reload >/dev/null 2>&1
        MSG='<div class="flash-ok">Konfiguracja WAN zapisana.</div>'
    fi
fi

LAN_IP=$(uci get network.lan.ipaddr 2>/dev/null)
LAN_MASK=$(uci get network.lan.netmask 2>/dev/null)
LAN_IP_ACT=$(ip -4 addr show br-lan 2>/dev/null | awk '/inet /{print $2}' | head -1)
WAN_PROTO=$(uci get network.wan.proto 2>/dev/null)
WAN_IP=$(ip -4 addr show eth1 2>/dev/null | awk '/inet /{print $2}' | head -1)
WAN_IP_CFG=$(uci get network.wan.ipaddr 2>/dev/null)
WAN_GW=$(uci get network.wan.gateway 2>/dev/null)
WAN_DNS=$(uci get network.wan.dns 2>/dev/null)
GW_ACT=$(ip route show default 2>/dev/null | awk '{print $3}' | head -1)

html_head "Siec" "network"

echo "$MSG"

cat << HTML
<div class="g2">
  <div class="card">
    <div class="sec">LAN</div>
    <p class="hint">Aktualny adres: <strong>${LAN_IP_ACT:-—}</strong></p>
    <form method="post">
    <input type="hidden" name="action" value="lan">
    <label>Adres IP</label>
    <input type="text" name="lan_ip" value="${LAN_IP:-192.168.1.1}" required>
    <label>Maska podsieci</label>
    <select name="lan_mask">
      <option value="255.255.255.0"$([ "$LAN_MASK" = "255.255.255.0" ] && echo ' selected')>/24 — 255.255.255.0</option>
      <option value="255.255.0.0"$([ "$LAN_MASK" = "255.255.0.0" ] && echo ' selected')>/16 — 255.255.0.0</option>
      <option value="255.0.0.0"$([ "$LAN_MASK" = "255.0.0.0" ] && echo ' selected')>/8 — 255.0.0.0</option>
    </select>
    <button type="submit" class="sm" style="margin-top:.6rem">Zapisz LAN</button>
    </form>
  </div>

  <div class="card">
    <div class="sec">WAN</div>
    <p class="hint">Aktualny IP: <strong>${WAN_IP:-—}</strong> &nbsp; Gateway: <strong>${GW_ACT:-—}</strong></p>
    <form method="post" id="wan-form">
    <input type="hidden" name="action" value="wan">
    <label>Protokol</label>
    <select name="wan_proto" onchange="toggleStatic(this.value)">
      <option value="dhcp"$([ "$WAN_PROTO" = "dhcp" ] && echo ' selected')>DHCP (automatyczny)</option>
      <option value="static"$([ "$WAN_PROTO" = "static" ] && echo ' selected')>Statyczny</option>
      <option value="pppoe"$([ "$WAN_PROTO" = "pppoe" ] && echo ' selected')>PPPoE</option>
    </select>
    <div id="static-fields" style="display:$([ "$WAN_PROTO" = "static" ] && echo 'block' || echo 'none')">
      <label>Adres IP WAN</label>
      <input type="text" name="wan_ip" value="${WAN_IP_CFG:-}">
      <label>Gateway</label>
      <input type="text" name="wan_gw" value="${WAN_GW:-}">
      <label>DNS (oddzielone spacją)</label>
      <input type="text" name="wan_dns" value="${WAN_DNS:-}">
    </div>
    <button type="submit" class="sm" style="margin-top:.6rem">Zapisz WAN</button>
    </form>
  </div>
</div>

<div class="card">
  <div class="sec">Interfejsy</div>
  <table>
    <thead><tr><th>Interfejs</th><th>Adres IP</th><th>MAC</th><th>Status</th></tr></thead>
    <tbody>
HTML

ip -4 addr show | awk '/^[0-9]+: /{iface=$2; sub(/:$/,"",iface)} /inet /{print iface, $2}' | \
while read -r iface addr; do
    mac=$(cat /sys/class/net/$iface/address 2>/dev/null || echo "—")
    state=$(cat /sys/class/net/$iface/operstate 2>/dev/null || echo "?")
    [ "$state" = "up" ] && badge='<span class="badge bg">UP</span>' || badge='<span class="badge br">DOWN</span>'
    printf '<tr><td>%s</td><td>%s</td><td>%s</td><td>%s</td></tr>\n' "$iface" "$addr" "$mac" "$badge"
done

cat << 'HTML'
    </tbody>
  </table>
</div>

<script>
function toggleStatic(v){document.getElementById('static-fields').style.display=v==='static'?'block':'none';}
</script>
HTML

html_foot

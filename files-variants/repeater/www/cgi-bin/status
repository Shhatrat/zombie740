#!/bin/sh
. /www/cgi-bin/common.sh

html_head "Status" "status"

UPTIME=$(awk '{s=$1/86400; h=($1%86400)/3600; m=($1%3600)/60; printf "%dd %dh %dm", s, h, m}' /proc/uptime)
MEMTOTAL=$(awk '/MemTotal/{print $2}' /proc/meminfo)
MEMFREE=$(awk '/MemAvailable/{print $2}' /proc/meminfo)
MEMUSED=$(( (MEMTOTAL - MEMFREE) / 1024 ))
MEMTOTAL_MB=$(( MEMTOTAL / 1024 ))
MEMPCT=$(( (MEMTOTAL - MEMFREE) * 100 / MEMTOTAL ))
LOAD=$(cut -d' ' -f1 /proc/loadavg)

LAN_IP=$(ip -4 addr show br-lan 2>/dev/null | awk '/inet /{print $2}' | head -1)
WWAN_IP=$(ip -4 addr show wlan0 2>/dev/null | awk '/inet /{print $2}' | head -1)
[ -z "$WWAN_IP" ] && WWAN_IP=$(ip -4 addr show wwan 2>/dev/null | awk '/inet /{print $2}' | head -1)
GW=$(ip route show default 2>/dev/null | awk '{print $3}' | head -1)
[ -z "$GW" ] && GW="—"

# WiFi client info
WIFI_SSID=$(uci get wireless.wwan.ssid 2>/dev/null)
WIFI_SIGNAL=$(iwinfo wlan0 info 2>/dev/null | awk '/Signal/{print $2}')
WIFI_QUALITY=$(iwinfo wlan0 info 2>/dev/null | awk '/Quality/{print $2}' | cut -d/ -f1)
WIFI_QUALITY_MAX=$(iwinfo wlan0 info 2>/dev/null | awk '/Quality/{print $2}' | cut -d/ -f2)
[ -n "$WIFI_QUALITY" ] && [ -n "$WIFI_QUALITY_MAX" ] && \
    WIFI_PCT=$(( WIFI_QUALITY * 100 / WIFI_QUALITY_MAX )) || WIFI_PCT=0
WIFI_CONNECTED=$(iwinfo wlan0 assoclist 2>/dev/null | grep -c "^[0-9A-F]")
[ "$WIFI_CONNECTED" -gt 0 ] 2>/dev/null && WIFI_UP='<span class="badge bg">&#9679; POLACZONY</span>' || WIFI_UP='<span class="badge br">&#9679; ROZLACZONY</span>'

# Color for signal
if [ "$WIFI_PCT" -ge 60 ]; then SIG_COLOR="#4caf50"
elif [ "$WIFI_PCT" -ge 30 ]; then SIG_COLOR="#ff9800"
else SIG_COLOR="#f44336"; fi

cat << HTML
<div class="g4">
  <div class="card">
    <div class="lbl">Uptime</div>
    <div class="val ok">$UPTIME</div>
  </div>
  <div class="card">
    <div class="lbl">RAM</div>
    <div class="val">$MEMUSED / $MEMTOTAL_MB MB</div>
  </div>
  <div class="card">
    <div class="lbl">Load avg</div>
    <div class="val ok">$LOAD</div>
  </div>
  <div class="card">
    <div class="lbl">WiFi WAN</div>
    <div class="val" style="font-size:.95rem">$WIFI_UP</div>
  </div>
</div>

<div class="g2">
  <div class="card">
    <div class="sec">WiFi upstream</div>
    <table><tbody>
      <tr><th>SSID</th><td>${WIFI_SSID:-—}</td></tr>
      <tr><th>Sygnal</th><td>
        ${WIFI_SIGNAL:-—} dBm
        <span class="signal-bar"><span class="signal-fill" style="width:${WIFI_PCT}%;background:${SIG_COLOR}"></span></span>
        ${WIFI_PCT}%
      </td></tr>
      <tr><th>Adres IP</th><td>${WWAN_IP:-—}</td></tr>
      <tr><th>Gateway</th><td>$GW</td></tr>
    </tbody></table>
  </div>
  <div class="card">
    <div class="sec">LAN</div>
    <table><tbody>
      <tr><th>Adres IP</th><td>${LAN_IP:-—}</td></tr>
      <tr><th>DHCP</th><td>192.168.100.100 – 249</td></tr>
    </tbody></table>
  </div>
</div>
HTML

# Connected LAN clients from DHCP leases
LEASES=$(cat /tmp/dhcp.leases 2>/dev/null)
LEASE_COUNT=$(echo "$LEASES" | grep -c . 2>/dev/null || echo 0)
[ -z "$LEASES" ] && LEASE_COUNT=0

echo '<div class="card">'
echo "<div class=\"sec\">Klienci LAN ($LEASE_COUNT)</div>"
if [ "$LEASE_COUNT" -gt 0 ]; then
    echo '<table><thead><tr><th>IP</th><th>MAC</th><th>Hostname</th><th>Wygasa</th></tr></thead><tbody>'
    echo "$LEASES" | while read -r expire mac ip host rest; do
        NOW=$(date +%s)
        LEFT=$(( expire - NOW ))
        [ "$LEFT" -gt 0 ] && TIME="${LEFT}s" || TIME="wygaslo"
        H=$(( LEFT / 3600 )); M=$(( (LEFT % 3600) / 60 ))
        [ "$LEFT" -gt 0 ] && TIME="${H}h ${M}m"
        printf '<tr><td>%s</td><td><code>%s</code></td><td>%s</td><td>%s</td></tr>\n' \
            "$ip" "$mac" "${host:-?}" "$TIME"
    done
    echo '</tbody></table>'
else
    echo '<p style="color:var(--pico-muted-color);margin:0">Brak aktywnych klientow DHCP.</p>'
fi
echo '</div>'

html_foot

config wifi-device 'radio0'
	option type 'mac80211'
	option path 'platform/ahb/18100000.wmac'
	option band '2g'
	option channel 'auto'
	option htmode 'HT20'
	option country 'PL'

config wifi-iface 'wwan'
	option device 'radio0'
	option mode 'sta'
	option network 'wwan'
	option ssid 'MyNetwork'
	option encryption 'psk2'
	option key 'mypassword'
	option disabled '0'
